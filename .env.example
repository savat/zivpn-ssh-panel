# รหัสเข้าหน้าเว็บ (ตั้งให้ยาวและเดายาก)
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# ใช้เซ็นคุกกี้ล็อกอิน (>= 32 ตัวอักษร)   สร้างด้วย: openssl rand -base64 48
SESSION_SECRET=

# ใช้เข้ารหัสรหัสผ่าน VPS ก่อนเก็บลงฐานข้อมูล (32 bytes base64)   สร้างด้วย: openssl rand -base64 32
# ห้ามทำหาย! ถ้าหาย รหัส VPS ที่เก็บไว้จะถอดไม่ได้
ENCRYPTION_KEY=

# Supabase (Project Settings > API) - ใช้ service_role key ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
